---
// src/components/GridMenu.astro
// Dynamic line-grid navigation — an original ARTOSHI take inspired by thonik's
// "grid of lines that forms from the logo". A terracotta seed grows out of the
// mascot, hands off to grey, and the screen partitions itself line-by-line into
// five Swiss zones (HOME · WORK · ABOUT · CONTACT · LAB). Reuses the site's own
// spring/scramble craft and WorkList vocabulary so it reads as ARTOSHI, not thonik.
import { work } from "../data/work";

const socials = [
  { label: "X", href: "https://x.com/artoshiverse" },
  { label: "IG", href: "https://instagram.com/artoshiverse" },
  { label: "GH", href: "https://github.com/artoshirei" },
];

const isExternal = (url?: string) => !!url && url.startsWith("http");

// Work rows, newest first, matching WorkList ordering.
const workRows = [...work].sort((a, b) => b.year - a.year);
---

<!-- Launcher: a 2×2 mini-grid that rhymes with the menu (not a hamburger) -->
<button
  type="button"
  class="grid-launcher"
  aria-haspopup="dialog"
  aria-expanded="false"
  aria-controls="grid-menu"
  aria-label="Open menu"
>
  <svg class="launcher-glyph" viewBox="0 0 24 24" aria-hidden="true" fill="none">
    <rect class="lg-sq lg-seed" x="3" y="3" width="7" height="7" />
    <rect class="lg-sq" x="14" y="3" width="7" height="7" />
    <rect class="lg-sq" x="3" y="14" width="7" height="7" />
    <rect class="lg-sq" x="14" y="14" width="7" height="7" />
  </svg>
  <span class="sr-only">Open menu</span>
</button>

<!-- Overlay -->
<div
  id="grid-menu"
  class="grid-menu"
  role="dialog"
  aria-modal="true"
  aria-label="Site navigation"
  hidden
>
  <div class="gm-backdrop"></div>

  <!-- The lines -->
  <svg class="gm-lines" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
    <!-- seed: a short accent diagonal near the logo origin (top-left) -->
    <line class="gm-line gm-seed" x1="11" y1="1.5" x2="2" y2="4" pathLength="1" vector-effect="non-scaling-stroke" />
    <!-- frame (clockwise from top-left), inset 2/98 × 4/96 -->
    <line class="gm-line gm-frame gm-f-top"    x1="2"  y1="4"  x2="98" y2="4"  pathLength="1" vector-effect="non-scaling-stroke" />
    <line class="gm-line gm-frame gm-f-right"  x1="98" y1="4"  x2="98" y2="96" pathLength="1" vector-effect="non-scaling-stroke" />
    <line class="gm-line gm-frame gm-f-bottom" x1="98" y1="96" x2="2"  y2="96" pathLength="1" vector-effect="non-scaling-stroke" />
    <line class="gm-line gm-frame gm-f-left"   x1="2"  y1="96" x2="2"  y2="4"  pathLength="1" vector-effect="non-scaling-stroke" />
    <!-- primary cuts -->
    <line class="gm-line gm-cut gm-vA" x1="60" y1="4"  x2="60" y2="96" pathLength="1" vector-effect="non-scaling-stroke" />
    <line class="gm-line gm-cut gm-vB" x1="80" y1="4"  x2="80" y2="96" pathLength="1" vector-effect="non-scaling-stroke" />
    <line class="gm-line gm-cut gm-hL" x1="2"  y1="58" x2="60" y2="58" pathLength="1" vector-effect="non-scaling-stroke" />
    <line class="gm-line gm-cut gm-hR" x1="80" y1="46" x2="98" y2="46" pathLength="1" vector-effect="non-scaling-stroke" />
  </svg>

  <!-- Intersection node dots (HTML so they stay square under the stretched viewBox) -->
  <div class="gm-nodes" aria-hidden="true">
    <span class="gm-node" style="left:60%; top:4%"></span>
    <span class="gm-node" style="left:60%; top:58%"></span>
    <span class="gm-node" style="left:60%; top:96%"></span>
    <span class="gm-node" style="left:80%; top:4%"></span>
    <span class="gm-node" style="left:80%; top:46%"></span>
    <span class="gm-node" style="left:80%; top:96%"></span>
  </div>

  <!-- Labels / destinations -->
  <div class="gm-zones">
    <!-- HOME hero -->
    <a class="gm-zone gm-hero-zone" id="z-home" href="/" aria-label="Home — ARTOSHI">
      <h2 class="gm-hero"><span class="gm-scramble" data-final="ARTOSHI" aria-hidden="true">ARTOSHI</span></h2>
      <p class="gm-tagline"><span class="gm-scramble" data-final="DESIGN + DEVELOPMENT" aria-hidden="true">DESIGN + DEVELOPMENT</span></p>
      <span class="gm-arrow" aria-hidden="true">↗</span>
    </a>

    <!-- WORK band: a button that subdivides into the project rows -->
    <button
      type="button"
      class="gm-zone gm-work-zone"
      id="z-work"
      aria-expanded="false"
      aria-controls="gm-work-panel"
      aria-label="Work — 5 projects"
    >
      <span class="gm-zone-head">
        <span class="gm-zone-label"><span class="gm-scramble" data-final="WORK" aria-hidden="true">WORK</span></span>
        <span class="gm-meta">5 PROJECTS</span>
      </span>
      <div class="gm-work-rows" id="gm-work-panel" hidden>
        {workRows.map((item) => (
          <a
            class="gm-row"
            href={item.url}
            tabindex="-1"
            target={isExternal(item.url) ? "_blank" : "_self"}
            rel={isExternal(item.url) ? "noopener noreferrer" : undefined}
          >
            <span class="work-title">{item.title}</span>
            {item.description && <span class="work-desc">{item.description}</span>}
            <span class="work-right">
              <span class="work-tag">{item.categories[0]}</span>
              <span class="work-arrow" aria-hidden="true">
                {isExternal(item.url) ? (
                  <svg focusable="false" fill="currentColor" width="10" height="10" viewBox="0 0 32 32"><path d="M10 6L10 8 22.59 8 6 24.59 7.41 26 24 9.41 24 22 26 22 26 6 10 6z" /></svg>
                ) : (
                  <svg focusable="false" fill="currentColor" width="10" height="10" viewBox="0 0 32 32"><circle cx="16" cy="16" r="8" /></svg>
                )}
              </span>
            </span>
          </a>
        ))}
      </div>
    </button>

    <!-- ABOUT: the narrow full-height vertical column -->
    <a class="gm-zone gm-about-zone" id="z-about" href="/#bio" aria-label="About">
      <span class="gm-zone-label gm-vertical"><span class="gm-scramble" data-final="ABOUT" aria-hidden="true">ABOUT</span></span>
    </a>

    <!-- CONTACT: socials -->
    <div class="gm-zone gm-contact-zone" id="z-contact" role="group" aria-label="Contact">
      <span class="gm-zone-tag">CONTACT</span>
      <div class="gm-socials">
        {socials.map((s) => (
          <a class="gm-social" href={s.href} target="_blank" rel="noopener noreferrer">
            <span class="gm-scramble" data-final={s.label} aria-hidden="true">{s.label}</span>
            <svg class="gm-social-arrow" focusable="false" fill="currentColor" width="9" height="9" viewBox="0 0 32 32" aria-hidden="true"><path d="M10 6L10 8 22.59 8 6 24.59 7.41 26 24 9.41 24 22 26 22 26 6 10 6z" /></svg>
          </a>
        ))}
      </div>
    </div>

    <!-- LAB: shortcut to the experiments -->
    <a class="gm-zone gm-lab-zone" id="z-lab" href="/experiments/pretext-drift" aria-label="Lab — Pretext Drift">
      <span class="gm-zone-label"><span class="gm-scramble" data-final="LAB" aria-hidden="true">LAB</span></span>
      <span class="gm-meta">PRETEXT DRIFT</span>
    </a>
  </div>

  <!-- Close -->
  <button type="button" class="gm-close" aria-label="Close menu">
    <svg viewBox="0 0 24 24" aria-hidden="true" fill="none">
      <line x1="5" y1="5" x2="19" y2="19" />
      <line x1="19" y1="5" x2="5" y2="19" />
    </svg>
  </button>
</div>

<style>
  /* ─── Tokens (local) ─────────────────────────────────── */
  .grid-menu {
    --gm-line-rest: var(--color-border-strong);
    --gm-line-active: rgba(255, 255, 255, 0.5);
    --gm-node: var(--color-secondary);
    --gm-seed: var(--color-accent);
    --gm-ease-out: cubic-bezier(0.16, 1, 0.3, 1);
    --gm-ease-in: cubic-bezier(0.7, 0, 0.84, 0);
  }

  .sr-only {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0 0 0 0);
    white-space: nowrap; border: 0;
  }

  /* ─── Launcher ───────────────────────────────────────── */
  .grid-launcher {
    appearance: none;
    background: none;
    border: none;
    padding: 0.5rem;
    margin: -0.5rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: var(--color-secondary);
    -webkit-tap-highlight-color: transparent;
  }
  .launcher-glyph {
    width: 18px;
    height: 18px;
  }
  .lg-sq {
    stroke: var(--color-border-strong);
    stroke-width: 1.5;
    transform-box: fill-box;
    transform-origin: center;
    transition: transform 0.35s var(--gm-ease-out), stroke 0.25s ease;
  }
  @media (pointer: fine) {
    .grid-launcher:hover .lg-sq { stroke: var(--color-secondary); }
    .grid-launcher:hover .lg-sq:nth-child(1) { transform: translate(-1px, -1px); }
    .grid-launcher:hover .lg-sq:nth-child(2) { transform: translate(1px, -1px); }
    .grid-launcher:hover .lg-sq:nth-child(3) { transform: translate(-1px, 1px); }
    .grid-launcher:hover .lg-sq:nth-child(4) { transform: translate(1px, 1px); }
    .grid-launcher:hover .lg-seed { stroke: var(--color-accent); }
  }
  .grid-launcher:focus-visible {
    outline: 1px solid var(--color-accent);
    outline-offset: 3px;
    border-radius: 2px;
  }

  /* ─── Overlay shell ──────────────────────────────────── */
  .grid-menu {
    position: fixed;
    inset: 0;
    z-index: 80;
  }
  .grid-menu[hidden] { display: none; }

  .gm-backdrop {
    position: absolute;
    inset: 0;
    background: var(--color-bg);
    opacity: 0;
    transition: opacity 0.22s var(--gm-ease-out);
  }
  .grid-menu.is-open .gm-backdrop { opacity: 1; }
  .grid-menu.is-closing .gm-backdrop { opacity: 0; transition-duration: 0.32s; transition-timing-function: var(--gm-ease-in); }

  /* ─── Lines ──────────────────────────────────────────── */
  .gm-lines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .gm-line {
    stroke: var(--gm-line-rest);
    stroke-width: 1;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 0.3s var(--gm-ease-out);
  }
  .gm-seed { stroke: var(--gm-seed); transition: stroke-dashoffset 0.24s var(--gm-ease-out), stroke 0.18s linear 0.24s; }

  /* open: draw everything, staggered */
  .grid-menu.is-open .gm-line  { stroke-dashoffset: 0; }
  .grid-menu.is-open .gm-seed  { stroke: var(--gm-line-rest); }
  .grid-menu.is-open .gm-f-top    { transition-delay: 0.20s; transition-duration: 0.26s; }
  .grid-menu.is-open .gm-f-right  { transition-delay: 0.24s; transition-duration: 0.26s; }
  .grid-menu.is-open .gm-f-bottom { transition-delay: 0.28s; transition-duration: 0.26s; }
  .grid-menu.is-open .gm-f-left   { transition-delay: 0.32s; transition-duration: 0.26s; }
  .grid-menu.is-open .gm-vA { transition-delay: 0.46s; }
  .grid-menu.is-open .gm-vB { transition-delay: 0.56s; }
  .grid-menu.is-open .gm-hL { transition-delay: 0.68s; transition-duration: 0.28s; }
  .grid-menu.is-open .gm-hR { transition-delay: 0.74s; transition-duration: 0.28s; }

  /* close: retract all together, faster, ease-in */
  .grid-menu.is-closing .gm-line {
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 0.32s var(--gm-ease-in);
    transition-delay: 0s;
  }
  .grid-menu.is-closing .gm-seed { stroke: var(--gm-seed); transition-delay: 0.16s; }

  /* ─── Nodes ──────────────────────────────────────────── */
  .gm-nodes { position: absolute; inset: 0; }
  .gm-node {
    position: absolute;
    width: 4px; height: 4px;
    background: var(--gm-node);
    transform: translate(-50%, -50%) scale(0);
    transition: transform 0.16s var(--gm-ease-out);
  }
  .grid-menu.is-open .gm-node { transform: translate(-50%, -50%) scale(1); }
  .grid-menu.is-open .gm-node:nth-child(1) { transition-delay: 0.86s; }
  .grid-menu.is-open .gm-node:nth-child(2) { transition-delay: 0.98s; }
  .grid-menu.is-open .gm-node:nth-child(3) { transition-delay: 0.92s; }
  .grid-menu.is-open .gm-node:nth-child(4) { transition-delay: 0.90s; }
  .grid-menu.is-open .gm-node:nth-child(5) { transition-delay: 1.02s; }
  .grid-menu.is-open .gm-node:nth-child(6) { transition-delay: 0.96s; }

  /* ─── Zones layer ────────────────────────────────────── */
  .gm-zones { position: absolute; inset: 0; pointer-events: none; }

  .gm-zone {
    position: absolute;
    pointer-events: auto;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: var(--color-secondary);
    background: none;
    border: none;
    text-align: left;
    font-family: var(--font-sans);
    padding: 1.25rem;
    overflow: hidden;
    transition: background-color 0.3s var(--gm-ease-out), color 0.3s var(--gm-ease-out);
  }
  a.gm-zone, button.gm-zone { cursor: pointer; }

  /* rects (x..x, y..y as % of viewport) */
  #z-home    { left: 2%;  top: 4%;  width: 58%; height: 54%; justify-content: flex-end; }
  #z-work    { left: 2%;  top: 58%; width: 58%; height: 38%; }
  #z-about   { left: 60%; top: 4%;  width: 20%; height: 92%; align-items: center; justify-content: center; }
  #z-contact { left: 80%; top: 4%;  width: 18%; height: 42%; justify-content: space-between; }
  #z-lab     { left: 80%; top: 46%; width: 18%; height: 50%; justify-content: flex-end; }

  @media (pointer: fine) {
    .gm-zone:hover { background-color: var(--color-hover-bg); color: var(--color-primary); }
  }
  .gm-zone:focus-visible {
    outline: 1px solid var(--color-accent);
    outline-offset: -2px;
    color: var(--color-primary);
  }

  /* labels */
  .gm-zone-label, .gm-zone-tag, .gm-meta {
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .gm-zone-label { font-size: 0.85rem; color: var(--color-primary); }
  .gm-zone-tag, .gm-meta { font-size: 0.62rem; color: var(--color-tertiary); }
  .gm-meta { margin-top: 0.35rem; }

  .gm-zone-head { display: flex; flex-direction: column; }

  /* HOME hero */
  .gm-hero {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: clamp(2rem, 5vw, 3.25rem);
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--color-primary);
    margin: 0;
  }
  .gm-tagline {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-tertiary);
    margin: 0.6rem 0 0;
  }
  .gm-arrow {
    position: absolute;
    top: 1.25rem; right: 1.25rem;
    font-size: 0.9rem;
    color: var(--color-primary);
    opacity: 0;
    transform: translate(-3px, 3px);
    transition: opacity 0.2s ease, transform 0.2s ease;
  }
  .gm-hero-zone:hover .gm-arrow,
  .gm-hero-zone:focus-visible .gm-arrow { opacity: 1; transform: translate(0, 0); }

  /* ABOUT vertical label */
  .gm-vertical {
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    letter-spacing: 0.14em;
  }

  /* CONTACT socials */
  .gm-socials { display: flex; flex-direction: column; gap: 0.5rem; align-items: flex-start; }
  .gm-social {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.05em;
    color: var(--color-secondary);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .gm-social-arrow { opacity: 0.4; transition: opacity 0.15s ease, transform 0.15s ease; }
  .gm-social:hover { color: var(--color-primary); }
  .gm-social:hover .gm-social-arrow { opacity: 1; transform: translate(1px, -1px); }
  .gm-social:focus-visible { outline: 1px solid var(--color-accent); outline-offset: 2px; color: var(--color-primary); }

  /* WORK rows (reusing WorkList vocabulary) */
  .gm-work-rows { margin-top: 0.85rem; display: block; }
  .gm-work-rows[hidden] { display: none; }
  .gm-row {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-rows: auto auto;
    gap: 0.05rem 1rem;
    padding: 0.3rem 0.5rem 0.3rem 0;
    border-top: 1px solid var(--color-border);
    text-decoration: none;
    color: var(--color-secondary);
    opacity: 0;
    transform: translateY(4px);
    transition: opacity 0.4s var(--gm-ease-out), transform 0.4s var(--gm-ease-out), color 0.2s ease, background-color 0.2s ease;
  }
  .gm-work-zone[aria-expanded="true"] .gm-row { opacity: 1; transform: translateY(0); }
  .gm-work-zone[aria-expanded="true"] .gm-row:nth-child(1) { transition-delay: 0.06s; }
  .gm-work-zone[aria-expanded="true"] .gm-row:nth-child(2) { transition-delay: 0.12s; }
  .gm-work-zone[aria-expanded="true"] .gm-row:nth-child(3) { transition-delay: 0.18s; }
  .gm-work-zone[aria-expanded="true"] .gm-row:nth-child(4) { transition-delay: 0.24s; }
  .gm-work-zone[aria-expanded="true"] .gm-row:nth-child(5) { transition-delay: 0.30s; }
  @media (pointer: fine) {
    .gm-row:hover { color: var(--color-primary); background-color: var(--color-hover-bg); }
  }
  .gm-row:focus-visible { outline: 1px solid var(--color-accent); outline-offset: -1px; color: var(--color-primary); }
  .work-title { grid-column: 1; grid-row: 1; font-size: 0.8rem; font-weight: 500; color: inherit; white-space: nowrap; }
  .work-desc { grid-column: 1 / -1; grid-row: 2; font-size: 0.72rem; color: inherit; opacity: 0.6; }
  .work-right { grid-column: 2; grid-row: 1; display: flex; align-items: center; gap: 0.4rem; }
  .work-tag { font-family: var(--font-mono); font-size: 0.6rem; letter-spacing: 0.04em; color: var(--color-tertiary); white-space: nowrap; }
  .work-arrow { color: var(--color-primary); opacity: 0; transition: opacity 0.15s ease; }
  .gm-row:hover .work-arrow, .gm-row:focus-visible .work-arrow { opacity: 1; }

  /* a hint that WORK expands */
  .gm-work-zone::after {
    content: "+";
    position: absolute;
    top: 1.25rem; right: 1.25rem;
    font-family: var(--font-mono);
    color: var(--color-tertiary);
    transition: transform 0.3s var(--gm-ease-out), color 0.2s ease;
  }
  .gm-work-zone[aria-expanded="true"]::after { transform: rotate(45deg); color: var(--color-secondary); }

  /* ─── Close button ───────────────────────────────────── */
  .gm-close {
    position: absolute;
    top: 1rem; right: 1.1rem;
    width: 40px; height: 40px;
    display: flex; align-items: center; justify-content: center;
    background: none; border: none; cursor: pointer;
    color: var(--color-secondary);
    opacity: 0;
    transition: opacity 0.3s var(--gm-ease-out) 0.4s, color 0.2s ease;
  }
  .grid-menu.is-open .gm-close { opacity: 1; }
  .gm-close svg { width: 18px; height: 18px; }
  .gm-close line { stroke: currentColor; stroke-width: 1.25; }
  .gm-close:hover { color: var(--color-primary); }
  .gm-close:focus-visible { outline: 1px solid var(--color-accent); outline-offset: 2px; }

  /* ─── Label entrance (under the scramble) ────────────── */
  .gm-zone .gm-scramble,
  .gm-tagline .gm-scramble { display: inline-block; }
  .gm-zone,
  .gm-hero, .gm-tagline { opacity: 0; transition: opacity 0.4s var(--gm-ease-out); }
  .grid-menu.is-open .gm-zone,
  .grid-menu.is-open .gm-hero,
  .grid-menu.is-open .gm-tagline { opacity: 1; }
  .grid-menu.is-open #z-home   { transition-delay: 0.80s; }
  .grid-menu.is-open #z-work   { transition-delay: 0.95s; }
  .grid-menu.is-open #z-about  { transition-delay: 1.00s; }
  .grid-menu.is-open #z-contact{ transition-delay: 1.10s; }
  .grid-menu.is-open #z-lab    { transition-delay: 1.15s; }

  /* ─── Mobile: vertical stack ─────────────────────────── */
  @media (max-width: 767px) {
    .gm-lines, .gm-nodes { display: none; }
    .gm-zones {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      overflow-y: auto;
      pointer-events: auto;
      padding: 4.5rem 0 2rem;
    }
    .gm-zone {
      position: static;
      width: 100% !important; height: auto !important;
      left: auto; top: auto;
      min-height: 56px;
      padding: 1.1rem 1.5rem;
      border-top: 1px solid var(--color-border-strong);
      justify-content: center !important;
      align-items: flex-start !important;
    }
    #z-home { border-top: none; min-height: 120px; justify-content: center !important; }
    .gm-vertical { writing-mode: horizontal-tb; transform: none; letter-spacing: 0.06em; }
    .gm-work-rows[hidden] { display: block; } /* always shown on mobile */
    .gm-work-rows { margin-top: 0.6rem; }
    .gm-work-zone[aria-expanded] .gm-row { opacity: 1; transform: none; transition-delay: 0s !important; }
    .gm-work-zone::after { display: none; }
    .gm-arrow { display: none; }
    .gm-contact-zone { flex-direction: column; gap: 0.6rem; }
    .gm-socials { flex-direction: row; gap: 1.25rem; }
  }

  /* ─── Reduced motion ─────────────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    .gm-line, .gm-seed, .gm-node, .gm-backdrop,
    .gm-zone, .gm-hero, .gm-tagline, .gm-row, .lg-sq,
    .gm-close, .gm-work-zone::after {
      transition: none !important;
    }
    .grid-menu.is-open .gm-line { stroke-dashoffset: 0; }
    .grid-menu.is-open .gm-node { transform: translate(-50%, -50%) scale(1); }
  }
</style>

<script>
  // ─── Dynamic line-grid menu controller ──────────────────
  const launcher = document.querySelector<HTMLButtonElement>(".grid-launcher");
  const overlay = document.getElementById("grid-menu");
  const closeBtn = overlay?.querySelector<HTMLButtonElement>(".gm-close");
  const workZone = overlay?.querySelector<HTMLButtonElement>("#z-work");
  const workPanel = overlay?.querySelector<HTMLElement>("#gm-work-panel");
  const workRows = overlay ? Array.from(overlay.querySelectorAll<HTMLAnchorElement>(".gm-row")) : [];
  const scrambleEls = overlay ? Array.from(overlay.querySelectorAll<HTMLElement>(".gm-scramble")) : [];
  const nodes = overlay ? Array.from(overlay.querySelectorAll<HTMLElement>(".gm-node")) : [];

  const prefersReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const finePointer = window.matchMedia("(pointer: fine)").matches;

  if (launcher && overlay && closeBtn && workZone && workPanel) {
    let state: "closed" | "open" | "workOpen" = "closed";
    let lastFocus: HTMLElement | null = null;
    let scrollY = 0;
    let closeTimer: number | null = null;

    // ── scramble (mirrors SiteHeader) ──
    const POOL = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789 +";
    const TICK_MS = 35;
    function scramble(el: HTMLElement) {
      const final = el.dataset.final ?? el.textContent ?? "";
      let resolved = 0;
      const id = window.setInterval(() => {
        el.textContent = final
          .split("")
          .map((ch, i) => (i < resolved ? ch : ch === " " ? " " : POOL[Math.floor(Math.random() * POOL.length)]))
          .join("");
        resolved++;
        if (resolved >= final.length) {
          el.textContent = final;
          window.clearInterval(id);
        }
      }, TICK_MS);
    }
    function resetLabels() {
      scrambleEls.forEach((el) => { el.textContent = el.dataset.final ?? ""; });
    }

    // ── focus trap ──
    function focusables(): HTMLElement[] {
      if (!overlay) return [];
      return Array.from(
        overlay.querySelectorAll<HTMLElement>(
          'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])'
        )
      ).filter((el) => el.offsetParent !== null || el === closeBtn);
    }

    function onKeydown(e: KeyboardEvent) {
      if (e.key === "Escape") {
        e.preventDefault();
        if (state === "workOpen") closeWork();
        else close();
        return;
      }
      if (e.key === "Tab") {
        const list = focusables();
        if (list.length === 0) return;
        const first = list[0];
        const last = list[list.length - 1];
        const active = document.activeElement as HTMLElement;
        if (e.shiftKey && active === first) { e.preventDefault(); last.focus(); }
        else if (!e.shiftKey && active === last) { e.preventDefault(); first.focus(); }
      }
    }

    // ── node magnetism (desktop only) ──
    function onPointerMove(e: PointerEvent) {
      if (!finePointer || prefersReduced) return;
      let nearest: HTMLElement | null = null;
      let best = 70; // px radius
      for (const n of nodes) {
        const r = n.getBoundingClientRect();
        const dx = e.clientX - (r.left + r.width / 2);
        const dy = e.clientY - (r.top + r.height / 2);
        const d = Math.hypot(dx, dy);
        if (d < best) { best = d; nearest = n; }
      }
      for (const n of nodes) {
        if (n === nearest) {
          const r = n.getBoundingClientRect();
          const dx = e.clientX - (r.left + r.width / 2);
          const dy = e.clientY - (r.top + r.height / 2);
          const mag = Math.hypot(dx, dy) || 1;
          const pull = Math.min(mag, 4);
          n.style.transform = `translate(calc(-50% + ${(dx / mag) * pull}px), calc(-50% + ${(dy / mag) * pull}px)) scale(1)`;
        } else {
          n.style.transform = "";
        }
      }
    }
    function clearMagnet() { nodes.forEach((n) => (n.style.transform = "")); }

    // ── work subdivide ──
    function openWork() {
      if (!workPanel) return;
      workPanel.hidden = false;
      workZone!.setAttribute("aria-expanded", "true");
      workRows.forEach((r) => r.setAttribute("tabindex", "0"));
      state = "workOpen";
    }
    function closeWork() {
      workZone!.setAttribute("aria-expanded", "false");
      workRows.forEach((r) => r.setAttribute("tabindex", "-1"));
      // keep panel in DOM but hide after the rows fade
      window.setTimeout(() => { if (state !== "workOpen") workPanel!.hidden = true; }, prefersReduced ? 0 : 220);
      state = "open";
    }

    // ── open / close ──
    function open() {
      if (state !== "closed") return;
      if (closeTimer) { window.clearTimeout(closeTimer); closeTimer = null; }
      lastFocus = document.activeElement as HTMLElement;
      scrollY = window.scrollY;
      document.body.style.position = "fixed";
      document.body.style.top = `-${scrollY}px`;
      document.body.style.width = "100%";

      overlay!.hidden = false;
      resetLabels();
      // force reflow so the transition runs from the hidden state
      void overlay!.offsetWidth;
      overlay!.classList.add("is-open");
      launcher!.setAttribute("aria-expanded", "true");
      state = "open";

      // On mobile the WORK rows are always shown inline (no subdivide step)
      if (window.matchMedia("(max-width: 767px)").matches) {
        workPanel!.hidden = false;
        workZone!.setAttribute("aria-expanded", "true");
        workRows.forEach((r) => r.setAttribute("tabindex", "0"));
      }

      document.addEventListener("keydown", onKeydown);
      if (finePointer && !prefersReduced) overlay!.addEventListener("pointermove", onPointerMove);

      if (!prefersReduced) {
        const order = [
          { sel: '#z-home .gm-scramble', at: 820 },
          { sel: '#z-about .gm-scramble', at: 1000 },
          { sel: '#z-work .gm-zone-label .gm-scramble', at: 1050 },
          { sel: '#z-contact .gm-scramble', at: 1120 },
          { sel: '#z-lab .gm-scramble', at: 1160 },
        ];
        order.forEach(({ sel, at }) => {
          const el = overlay!.querySelector<HTMLElement>(sel);
          if (el) window.setTimeout(() => scramble(el), at);
        });
        window.setTimeout(() => focusFirst(), 900);
      } else {
        focusFirst();
      }
    }

    function focusFirst() {
      const home = overlay!.querySelector<HTMLElement>("#z-home");
      home?.focus();
    }

    function close() {
      if (state === "closed") return;
      if (state === "workOpen") closeWork();
      overlay!.classList.remove("is-open");
      overlay!.classList.add("is-closing");
      launcher!.setAttribute("aria-expanded", "false");
      document.removeEventListener("keydown", onKeydown);
      overlay!.removeEventListener("pointermove", onPointerMove);
      clearMagnet();
      state = "closed";

      const finish = () => {
        overlay!.hidden = true;
        overlay!.classList.remove("is-closing");
        workPanel!.hidden = true;
        workZone!.setAttribute("aria-expanded", "false");
        document.body.style.position = "";
        document.body.style.top = "";
        document.body.style.width = "";
        window.scrollTo(0, scrollY);
        lastFocus?.focus();
        closeTimer = null;
      };
      if (prefersReduced) finish();
      else closeTimer = window.setTimeout(finish, 500);
    }

    launcher.addEventListener("click", open);
    closeBtn.addEventListener("click", close);
    workZone.addEventListener("click", (e) => {
      // only the head toggles; clicks on rows navigate
      if ((e.target as HTMLElement).closest(".gm-row")) return;
      // on mobile the rows are always inline — no toggle
      if (window.matchMedia("(max-width: 767px)").matches) return;
      e.preventDefault();
      if (state === "workOpen") closeWork();
      else openWork();
    });
    // backdrop click closes
    overlay.querySelector(".gm-backdrop")?.addEventListener("click", close);

    document.addEventListener("visibilitychange", () => {
      if (document.hidden) clearMagnet();
    });
  }
</script>
