---
// src/components/SiteHeader.astro — minimal header, bigger gray eye-tracking mascot
---

<header class="header animate-in-fade">
  <a href="/" class="header-brand" aria-label="ARTOSHI — home">
    <svg
      id="mascot-icon"
      class="header-mascot"
      viewBox="0 0 649 512"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
    >
      <defs>
        <clipPath id="body-clip">
          <path d="M562.831 269.466C613.091 251.273 649 203.129 649 146.602C649 74.4521 590.502 15.9636 518.341 15.9636C481.989 15.9636 449.102 30.8084 425.419 54.7668C403.962 21.7985 366.776 0 324.502 0C282.224 0 245.042 21.7985 223.58 54.7668C199.898 30.8084 167.011 15.9636 130.659 15.9636C58.4976 15.9636 0 74.4521 0 146.602C0 204.876 38.1635 254.242 90.8688 271.071C54.4352 294.25 30.2622 334.981 30.2622 381.361C30.2622 453.511 88.7598 512 160.921 512C192.767 512 221.954 500.61 244.625 481.673C265.871 500.537 293.844 512 324.502 512C356.882 512 386.271 499.212 407.9 478.416C431.057 499.294 461.724 512 495.36 512C567.521 512 626.019 453.511 626.019 381.361C626.019 333.897 600.701 292.344 562.831 269.466Z" />
        </clipPath>
      </defs>
      <path
        d="M562.831 269.466C613.091 251.273 649 203.129 649 146.602C649 74.4521 590.502 15.9636 518.341 15.9636C481.989 15.9636 449.102 30.8084 425.419 54.7668C403.962 21.7985 366.776 0 324.502 0C282.224 0 245.042 21.7985 223.58 54.7668C199.898 30.8084 167.011 15.9636 130.659 15.9636C58.4976 15.9636 0 74.4521 0 146.602C0 204.876 38.1635 254.242 90.8688 271.071C54.4352 294.25 30.2622 334.981 30.2622 381.361C30.2622 453.511 88.7598 512 160.921 512C192.767 512 221.954 500.61 244.625 481.673C265.871 500.537 293.844 512 324.502 512C356.882 512 386.271 499.212 407.9 478.416C431.057 499.294 461.724 512 495.36 512C567.521 512 626.019 453.511 626.019 381.361C626.019 333.897 600.701 292.344 562.831 269.466Z"
        fill="var(--mascot)"
      />
      <g clip-path="url(#body-clip)">
        <g transform="translate(235, 124)">
          <g class="mascot-eyes-travel">
            <rect class="mascot-eye-left" x="15.92" y="32.08" width="46" height="198" rx="23" fill="var(--paper)" />
            <rect class="mascot-eye-right" x="104.42" y="32.08" width="46" height="198" rx="23" fill="var(--paper)" />
          </g>
        </g>
      </g>
    </svg>
    <span class="header-word" id="header-scramble" data-final="artoshi">artoshi</span>
  </a>

  <span class="header-index t-meta">index / 2026</span>
</header>

<style>
  .header {
    max-width: var(--container-max);
    margin: 0 auto;
    width: 100%;
    padding: clamp(1rem, 2.2vw, 1.6rem) var(--frame);
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: var(--hair) solid var(--line-strong);
  }
  .header-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    text-decoration: none;
    color: var(--ink);
  }
  .header-mascot {
    display: block;
    width: clamp(46px, 5.2vw, 62px);
    height: auto;
    overflow: visible;
    flex-shrink: 0;
  }
  .header-word {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.35rem, 2.4vw, 1.7rem);
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  .header-index { color: var(--ink-faint); }
</style>

<script>
  import { init } from "../scripts/mascotEye";

  const svg = document.getElementById("mascot-icon") as unknown as SVGSVGElement | null;
  init(svg);

  // quiet scramble reveal on the wordmark (entrance only)
  const prefersReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const POOL = "abcdefghijklmnopqrstuvwxyz";
  if (!prefersReduced) {
    const el = document.getElementById("header-scramble");
    if (el) {
      const final = el.dataset.final ?? el.textContent ?? "";
      let resolved = 0;
      const id = window.setInterval(() => {
        el.textContent = final.split("").map((ch, i) => (i < resolved ? ch : POOL[Math.floor(Math.random() * POOL.length)])).join("");
        resolved++;
        if (resolved >= final.length) { el.textContent = final; window.clearInterval(id); }
      }, 38);
    }
  }
</script>
