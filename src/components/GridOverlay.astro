---
// src/components/GridOverlay.astro — the visible structural lattice
---

<div class="grid-overlay" aria-hidden="true">
  <div class="grid-overlay-inner"></div>
</div>

<style>
  .grid-overlay {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 0;
  }
  .grid-overlay-inner {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: min(var(--container-max), calc(100% - 2 * var(--frame)));
    border-left: var(--hair) solid var(--grid-line);
    border-right: var(--hair) solid var(--grid-line);
    background-image: repeating-linear-gradient(
      to right,
      var(--grid-line) 0,
      var(--grid-line) var(--hair),
      transparent var(--hair),
      transparent calc(100% / var(--cols))
    );
    opacity: 0;
    animation: grid-fade 1.3s var(--ease-out) 0.15s forwards;
  }
  @keyframes grid-fade { to { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) {
    .grid-overlay-inner { opacity: 1; animation: none; }
  }
</style>
