---
// src/components/WorkLedger.astro — the categorized work ledger + the Reading Rule
import { grouped } from "../data/work";

const pad = (n: number) => String(n).padStart(2, "0");
const arrow = `<svg viewBox="0 0 32 32" width="10" height="10" fill="currentColor" aria-hidden="true"><path d="M10 6L10 8 22.59 8 6 24.59 7.41 26 24 9.41 24 22 26 22 26 6 10 6z"/></svg>`;
---

<section class="ledger" data-ledger aria-label="Selected work">
  <div class="rule" data-rule aria-hidden="true"></div>

  {grouped.map((group) => (
    <div class="group">
      <header class="group-head">
        <span class="t-label">{group.label}</span>
        <span class="t-meta group-count">{group.label.slice(0, 1)} / {pad(group.items.length)}</span>
      </header>
      <ul class="rows">
        {group.items.map((item) => {
          const single = item.facets.length === 1;
          const f0 = item.facets[0];
          const RowTag = single ? "a" : "div";
          const rowProps = single
            ? { href: f0.url, ...(f0.external ? { target: "_blank", rel: "noopener noreferrer" } : {}) }
            : {};
          return (
            <li>
              <RowTag class="row" data-row {...rowProps}>
                <span class="row-main">
                  <span class="t-row row-title">{item.title}</span>
                  <span class="row-desc">{item.description}</span>
                </span>
                <span class="row-meta">
                  {item.current && <span class="pill">building</span>}
                  {single ? (
                    <span class="chip chip-static">{f0.label}</span>
                  ) : (
                    item.facets.map((f) => (
                      <a
                        class="chip"
                        href={f.url}
                        aria-label={f.ariaLabel ?? f.label}
                        target={f.external ? "_blank" : "_self"}
                        rel={f.external ? "noopener noreferrer" : undefined}
                      >
                        {f.label}
                        {f.external && <Fragment set:html={arrow} />}
                      </a>
                    ))
                  )}
                  <span class="t-meta row-year">{item.year}</span>
                </span>
              </RowTag>
            </li>
          );
        })}
      </ul>
    </div>
  ))}
</section>

<style>
  .ledger { position: relative; margin-top: clamp(2.5rem, 8vh, 6rem); }

  .rule {
    position: absolute;
    left: 0;
    top: 0;
    height: 2px;
    width: 0;
    opacity: 0;
    background: var(--accent);
    transform: translateY(0);
    will-change: transform, width;
    pointer-events: none;
    z-index: 2;
  }

  .group + .group { margin-top: clamp(2rem, 5vh, 3.5rem); }
  .group-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding: 0.55rem 0;
    border-top: var(--hair) solid var(--line-strong);
  }
  .group-count { color: var(--ink-faint); }

  .rows { list-style: none; margin: 0; padding: 0; }

  .row {
    position: relative;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: clamp(1rem, 4vw, 3rem);
    padding: clamp(0.95rem, 2.1vw, 1.6rem) 0;
    border-top: var(--hair) solid var(--line);
    text-decoration: none;
    color: var(--ink);
  }

  .row-main { display: flex; flex-direction: column; gap: 0.35rem; min-width: 0; }
  .row-title {
    color: var(--ink);
    transform: translateX(0);
    transition: transform 0.5s var(--ease-out), color 0.4s ease;
  }
  .row-desc { font-family: var(--font-sans); font-size: 0.95rem; color: var(--ink-mute); }

  .row-meta { display: flex; align-items: center; gap: clamp(0.5rem, 1.5vw, 1rem); flex-shrink: 0; }
  .row-year { color: var(--ink-faint); }

  .pill {
    font-family: var(--font-mono);
    font-size: var(--fs-meta);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--accent);
    border: var(--hair) solid var(--accent-quiet);
    padding: 0.18rem 0.5rem;
    border-radius: 999px;
    white-space: nowrap;
  }

  .chip {
    font-family: var(--font-mono);
    font-size: var(--fs-meta);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--ink-mute);
    border: var(--hair) solid var(--line-strong);
    padding: 0.2rem 0.5rem;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.18s ease, border-color 0.18s ease;
  }
  a.chip:hover { color: var(--ink); border-color: var(--ink-mute); }
  a.chip:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .chip-static { color: var(--ink-faint); }

  /* active row (driven by the Reading Rule) */
  @media (pointer: fine) {
    .row.is-active .row-title { transform: translateX(14px); color: var(--ink); }
    .row.is-active .row-desc { color: var(--ink); }
    .ledger:has(.row:hover) .row:not(.is-active) .row-title { color: var(--ink-mute); }
  }
  .row:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; }

  /* reduced-motion: static highlight, no slide, no rule motion */
  @media (prefers-reduced-motion: reduce) {
    .row-title { transition: none; }
    .rule { display: none; }
    @media (pointer: fine) {
      .row:hover { border-top-color: var(--accent); }
    }
  }

  @media (max-width: 620px) {
    .row { flex-direction: column; gap: 0.7rem; }
    .row-meta { gap: 0.6rem; flex-wrap: wrap; }
  }
</style>

<script>
  import { setGaze, clearGaze } from "../scripts/mascotEye";

  const ledger = document.querySelector<HTMLElement>("[data-ledger]");
  const rule = ledger?.querySelector<HTMLElement>("[data-rule]");
  const rows = ledger ? Array.from(ledger.querySelectorAll<HTMLElement>("[data-row]")) : [];
  const finePointer = window.matchMedia("(pointer: fine)").matches;
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (ledger && rule && rows.length && finePointer && !reduced) {
    let y = 0, w = 0, targetY = 0, targetW = 0;
    let last = 0, running = false;
    let active: HTMLElement | null = null;

    function frame(now: number) {
      const delta = Math.min((now - last) / 16.67, 1.8);
      last = now;
      const k = 0.24 * delta;
      y += (targetY - y) * k;
      w += (targetW - w) * k;
      rule!.style.transform = `translateY(${y}px)`;
      rule!.style.width = `${Math.max(0, w)}px`;
      rule!.style.opacity = String(Math.min(Math.max(w, 0) / 40, 1));
      if (targetW === 0 && w < 0.5) {
        running = false;
        rule!.style.width = "0px";
        rule!.style.opacity = "0";
        return;
      }
      requestAnimationFrame(frame);
    }
    function ensure() {
      if (!running) { running = true; last = performance.now(); requestAnimationFrame(frame); }
    }
    function activate(row: HTMLElement) {
      if (active && active !== row) active.classList.remove("is-active");
      active = row;
      row.classList.add("is-active");
      const lr = ledger!.getBoundingClientRect();
      const rr = row.getBoundingClientRect();
      targetY = rr.top - lr.top;
      targetW = rr.width;
      setGaze(rr.left + rr.width / 2, rr.top + rr.height / 2);
      ensure();
    }
    function leave() {
      if (active) { active.classList.remove("is-active"); active = null; }
      targetW = 0;
      clearGaze();
      ensure();
    }

    rows.forEach((row) => row.addEventListener("pointerenter", () => activate(row)));
    ledger.addEventListener("pointerleave", leave);

    let rid: number | null = null;
    window.addEventListener("resize", () => {
      if (rid) cancelAnimationFrame(rid);
      rid = requestAnimationFrame(() => { if (active) activate(active); });
    });
  }
</script>
