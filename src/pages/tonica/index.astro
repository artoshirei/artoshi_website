---
// src/pages/tonica/index.astro
import GridFrame from "../../layouts/GridFrame.astro";
---

<GridFrame title="Tonica — Circle of Fifths for macOS" breadcrumb="Apps / Tonica">
  <div class="proj">
    <section class="proj-head">
      <div class="proj-icon-cell">
        <img src="/tonica-icon.png" alt="Tonica app icon" class="proj-icon" width="72" height="72" />
      </div>

      <div class="proj-titleblock">
        <h1 class="proj-title">Tonica</h1>
        <p class="proj-desc">
          A fast circle-of-fifths companion for macOS,<br />
          always one shortcut away.
        </p>
      </div>

      <div class="proj-cta">
        <div class="proj-download-cell">
          <a href="/tonica/download" class="ink-slab" id="download-btn">
            <svg class="apple-logo" viewBox="0 0 814 1000" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M788.1 340.9c-5.8 4.5-108.2 62.2-108.2 190.5 0 148.4 130.3 200.9 134.2 202.2-.6 3.2-20.7 71.9-68.7 141.9-42.8 61.6-87.5 123.1-155.5 123.1s-85.5-39.5-164-39.5c-76.5 0-103.7 40.8-165.9 40.8s-105.6-57.8-155.5-127.4c-58.3-81.2-105.3-207.6-105.3-328.5 0-193.1 125.5-295.6 249.1-295.6 65.7 0 120.4 43.1 161.6 43.1 39.2 0 100.2-45.7 174.5-45.7 28.2 0 129.5 2.6 196.3 99.5zm-271.5-90.1c30.8-36.5 52.7-87.1 52.7-137.8 0-7.1-.6-14.2-1.9-20-50.2 1.9-109.5 33.4-145.4 75.2-26.9 30.2-55.2 80.8-55.2 132.1 0 7.7.6 15.5 1.3 17.4 2.6.6 6.4 1.3 10.2 1.3 45 .1 101.5-30.1 138.3-68.2z"/></svg>
            Download
          </a>
        </div>
        <div class="proj-note-cell">
          <span class="proj-note">Requires macOS 14 or later</span>
        </div>
      </div>
    </section>

    <section class="proj-media">
      <img src="/tonica-screenshot.png" alt="Tonica panel showing the circle of fifths" class="proj-shot" />
    </section>
  </div>
</GridFrame>

<style>
  .proj { display: flex; flex-direction: column; flex: 1; min-height: 0; }
  .proj-head {
    display: grid;
    grid-template-columns: minmax(8.5rem, 0.72fr) minmax(0, 2fr) minmax(12rem, 0.9fr);
    align-items: stretch;
    min-height: clamp(13rem, 26vw, 18rem);
    border-bottom: var(--hair) solid var(--line);
  }
  .proj-head > * {
    box-sizing: border-box;
    min-width: 0;
    padding: clamp(1.35rem, 3vw, 2.5rem);
  }
  .proj-icon-cell {
    display: grid;
    place-items: center;
    border-right: var(--hair) solid var(--line);
  }
  .proj-icon {
    display: block;
    width: min(54%, 9rem);
    height: auto;
    max-width: none;
    border-radius: 22%;
  }
  .proj-titleblock {
    display: flex;
    flex-direction: column;
    justify-content: center;
    border-right: var(--hair) solid var(--line);
  }
  .proj-title {
    margin: 0;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: clamp(3.3rem, 7vw, 6.6rem);
    font-weight: 900;
    letter-spacing: -0.02em;
    line-height: 0.9;
  }
  .proj-desc {
    max-width: 24rem;
    margin: 1rem 0 0;
    color: var(--ink-mute);
    font-size: 0.95rem;
    line-height: 1.42;
  }
  .proj-cta {
    display: grid;
    grid-template-rows: 1fr auto;
    align-items: stretch;
    padding: 0 !important;
  }
  .proj-download-cell,
  .proj-note-cell {
    display: flex;
    align-items: center;
    padding: clamp(1.35rem, 3vw, 2.5rem);
  }
  .proj-download-cell { justify-content: center; }
  .proj-note-cell {
    min-height: 4rem;
    border-top: var(--hair) solid var(--line);
    justify-content: flex-start;
  }
  .proj-note {
    color: var(--ink-faint);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.02em;
    text-align: left;
  }

  .ink-slab {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 500;
    min-height: 2.5rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--paper);
    background: var(--ink);
    padding: 0 1.75rem;
    text-decoration: none;
    transition: background 0.18s var(--ease-out);
  }
  .ink-slab:hover { background: var(--accent); color: var(--accent-ink); }
  .apple-logo { width: 0.85rem; height: 0.85rem; transform: translateY(-0.04em); }

  @media (max-width: 1020px) {
    .proj-head {
      grid-template-columns: minmax(9rem, 0.42fr) minmax(0, 1fr);
      min-height: 0;
    }
    .proj-icon-cell,
    .proj-titleblock {
      min-height: clamp(12rem, 27vw, 16rem);
    }
    .proj-title {
      font-size: clamp(3.4rem, 8.4vw, 5rem);
    }
    .proj-icon {
      width: min(58%, 8.5rem);
    }
    .proj-titleblock {
      border-right: 0;
    }
    .proj-cta {
      grid-column: 1 / -1;
      grid-template-columns: minmax(0, 1fr) minmax(13rem, 0.44fr);
      grid-template-rows: 1fr;
      border-top: var(--hair) solid var(--line);
    }
    .proj-download-cell,
    .proj-note-cell {
      min-height: 5.75rem;
    }
    .proj-note-cell {
      border-top: 0;
      border-left: var(--hair) solid var(--line);
    }
  }

  @media (max-width: 640px) {
    .proj-head {
      grid-template-columns: 1fr;
      min-height: 0;
    }
    .proj-head > * {
      padding: 1.35rem;
    }
    .proj-icon-cell {
      display: flex;
      justify-content: flex-start;
      min-height: 0;
      border-right: 0;
      border-bottom: var(--hair) solid var(--line);
    }
    .proj-icon {
      width: 62px;
      height: 62px;
    }
    .proj-titleblock {
      min-height: 0;
      border-right: 0;
      border-bottom: var(--hair) solid var(--line);
    }
    .proj-cta {
      grid-column: auto;
      grid-template-columns: 1fr;
      grid-template-rows: 1fr auto;
      border-top: 0;
    }
    .proj-download-cell {
      min-height: 5.25rem;
    }
    .proj-note-cell {
      min-height: 4rem;
      border-left: 0;
      border-top: var(--hair) solid var(--line);
    }
    .proj-download-cell,
    .proj-note-cell {
      padding: 1.35rem;
    }
    .proj-title {
      font-size: clamp(3.2rem, 8.4vw, 5rem);
    }
  }

  .proj-media {
    flex: 1;
    display: grid;
    place-items: center;
    padding: clamp(2rem, 6vw, 5rem) clamp(1.25rem, 3vw, 3rem);
  }
  .proj-shot { width: 100%; max-width: 60rem; height: auto; display: block; }
</style>

<script>
  document.getElementById("download-btn")?.addEventListener("click", (e) => {
    e.preventDefault();
    const iframe = document.createElement("iframe");
    iframe.style.display = "none";
    iframe.src = "/tonica/download";
    document.body.appendChild(iframe);
    setTimeout(() => iframe.remove(), 10000);
  });
</script>
