  .steepfu-download:hover {
    background: #fff;
  }

  .apple-logo {
    flex: 0 0 auto;
    width: 0.875rem;
    height: 0.875rem;
    transform: translateY(-0.03em);
  }

  .steepfu-note {
    margin-top: 0.6rem;
    color: rgba(255, 241, 201, 0.46);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.02em;
    text-align: center;
  }

  .steepfu-demo-wrap {
    position: relative;
    display: grid;
    place-items: center;
    width: min(100%, 64rem);
    margin-top: 2.25rem;
    padding-bottom: 8rem;
