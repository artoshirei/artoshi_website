              <svg class="steepfu-fowl-labs-logo" viewBox="122 205 779 615" aria-hidden="true"><path d="M797.57 528.675C857.898 506.822 901 448.993 901 381.094C901 294.43 830.784 224.175 744.169 224.175C700.536 224.175 661.061 242.006 632.635 270.784C606.879 231.184 562.244 205 511.502 205C460.756 205 416.126 231.184 390.366 270.784C361.939 242.006 322.464 224.175 278.831 224.175C192.215 224.175 122 294.43 122 381.094C122 451.091 167.808 510.389 231.071 530.603C187.339 558.445 158.324 607.37 158.324 663.08C158.324 749.745 228.539 820 315.155 820C353.38 820 388.413 806.319 415.625 783.573C441.127 806.231 474.703 820 511.502 820C550.368 820 585.644 804.639 611.605 779.66C639.401 804.737 676.211 820 716.585 820C803.2 820 873.416 749.745 873.416 663.08C873.416 606.067 843.027 556.155 797.57 528.675Z" fill="currentColor"></path></svg>
