    padding: 1rem 1.5rem;
  }

  .steepfu-back {
    color: rgba(255, 241, 201, 0.48);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-decoration: none;
    opacity: 0.8;
    transition: opacity 0.15s ease, color 0.15s ease;
