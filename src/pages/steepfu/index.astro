<style>
  :global(body) {
    background: #050403;
  }

  .steepfu-page {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-height: 100vh;
    padding: 5vh 1.5rem 0;
  }

  .steepfu-intro {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .steepfu-icon {
    width: 72px;
    height: 72px;
    border-radius: 16px;
    box-shadow: none;
  }

  h1 {
    margin: 1rem 0 0;
    color: #fff1c9;
    font-size: clamp(2.8rem, 6vw, 4.4rem);
    font-weight: 760;
    letter-spacing: 0;
    line-height: 0.95;
    text-align: center;
  }

  .steepfu-intro > p {
    max-width: 24rem;
    margin: 0.65rem 0 0;
    color: rgba(255, 241, 201, 0.64);
    font-size: 0.95rem;
    line-height: 1.42;
    text-align: center;
  }

  .steepfu-cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-top: 1.75rem;
  }

  .steepfu-download {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 2.5rem;
    border-radius: 999px;
    padding: 0 1.75rem;
    background: #fff1c9;
    color: #0b0703;
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    font-weight: 650;
    line-height: 1;
    letter-spacing: 0;
    text-decoration: none;
    transition: background 0.2s ease;
