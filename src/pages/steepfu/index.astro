  .steepfu-demo-wrap::before {
    content: "";
    position: absolute;
    width: min(86vw, 40rem);
    height: 34rem;
    border-radius: 999px;
    background: radial-gradient(circle, rgba(154, 92, 42, 0.24) 0%, rgba(139, 87, 43, 0.14) 36%, transparent 74%);
    filter: blur(38px);
    opacity: 0.9;
    pointer-events: none;
  }

  .steepfu-demo-wrap :global(.steepfu-window) {
    z-index: 1;
  }

  .steepfu-footer {
    position: fixed;
    right: 0;
    bottom: 0;
    left: 0;
    display: flex;
