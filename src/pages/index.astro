---
// src/pages/index.astro — ARTOSHI · quiet single-column index
import BaseLayout from "../layouts/BaseLayout.astro";
import { work } from "../data/work";

const arrow = `<svg class="row-arrow" viewBox="0 0 32 32" width="11" height="11" fill="currentColor" aria-hidden="true"><path d="M10 6L10 8 22.59 8 6 24.59 7.41 26 24 9.41 24 22 26 22 26 6 10 6z"/></svg>`;

const socials = [
  { label: "x", href: "https://x.com/artoshiverse" },
  { label: "instagram", href: "https://instagram.com/artoshiverse" },
  { label: "github", href: "https://github.com/artoshirei" },
];
---

<BaseLayout title="artoshi — design + development">
  <div class="page">
    <header class="top animate-in-fade">
      <a href="/" class="brand" aria-label="artoshi — home">
        <svg id="mascot-icon" class="brand-mascot" viewBox="0 0 649 512" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <defs>
            <clipPath id="body-clip">
              <path d="M562.831 269.466C613.091 251.273 649 203.129 649 146.602C649 74.4521 590.502 15.9636 518.341 15.9636C481.989 15.9636 449.102 30.8084 425.419 54.7668C403.962 21.7985 366.776 0 324.502 0C282.224 0 245.042 21.7985 223.58 54.7668C199.898 30.8084 167.011 15.9636 130.659 15.9636C58.4976 15.9636 0 74.4521 0 146.602C0 204.876 38.1635 254.242 90.8688 271.071C54.4352 294.25 30.2622 334.981 30.2622 381.361C30.2622 453.511 88.7598 512 160.921 512C192.767 512 221.954 500.61 244.625 481.673C265.871 500.537 293.844 512 324.502 512C356.882 512 386.271 499.212 407.9 478.416C431.057 499.294 461.724 512 495.36 512C567.521 512 626.019 453.511 626.019 381.361C626.019 333.897 600.701 292.344 562.831 269.466Z" />
            </clipPath>
          </defs>
          <path d="M562.831 269.466C613.091 251.273 649 203.129 649 146.602C649 74.4521 590.502 15.9636 518.341 15.9636C481.989 15.9636 449.102 30.8084 425.419 54.7668C403.962 21.7985 366.776 0 324.502 0C282.224 0 245.042 21.7985 223.58 54.7668C199.898 30.8084 167.011 15.9636 130.659 15.9636C58.4976 15.9636 0 74.4521 0 146.602C0 204.876 38.1635 254.242 90.8688 271.071C54.4352 294.25 30.2622 334.981 30.2622 381.361C30.2622 453.511 88.7598 512 160.921 512C192.767 512 221.954 500.61 244.625 481.673C265.871 500.537 293.844 512 324.502 512C356.882 512 386.271 499.212 407.9 478.416C431.057 499.294 461.724 512 495.36 512C567.521 512 626.019 453.511 626.019 381.361C626.019 333.897 600.701 292.344 562.831 269.466Z" fill="var(--mascot)" />
          <g clip-path="url(#body-clip)">
            <g transform="translate(235, 124)">
              <g class="mascot-eyes-travel">
                <rect class="mascot-eye-left" x="15.92" y="32.08" width="46" height="198" rx="23" fill="var(--paper)" />
                <rect class="mascot-eye-right" x="104.42" y="32.08" width="46" height="198" rx="23" fill="var(--paper)" />
                <path class="mascot-eye-arc-left" d="M -28 14 A 28 28 0 0 1 28 14" fill="none" stroke="var(--paper)" stroke-width="20" stroke-linecap="round" opacity="0" />
                <path class="mascot-eye-arc-right" d="M -28 14 A 28 28 0 0 1 28 14" fill="none" stroke="var(--paper)" stroke-width="20" stroke-linecap="round" opacity="0" />
              </g>
            </g>
          </g>
        </svg>
        <span class="brand-word">artoshi</span>
      </a>
    </header>

    <main class="col">
      <section class="hero">
        <h1 class="t-hero">
          <span class="hero-line animate-in" style="animation-delay: 0.08s">I design &amp; build</span>
          <span class="hero-line animate-in" style="animation-delay: 0.16s">digital products.</span>
        </h1>
        <p class="hero-sub animate-in" style="animation-delay: 0.26s">
          BA Graphic Communication Design,<br />
          <a href="https://www.arts.ac.uk/colleges/central-saint-martins" target="_blank" rel="noopener noreferrer" class="quiet-link">Central Saint Martins</a>.
        </p>
      </section>

      <section class="work animate-in" style="animation-delay: 0.36s" aria-label="Selected work">
        <ol class="work-list">
          {work.map((item) => (
            <li>
              <a
                class="row"
                href={item.url}
                {...(item.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
              >
                {item.now && (
                  <span class="now-dot" aria-label="Building right now">
                    <span class="now-tip" role="tooltip">building right now</span>
                  </span>
                )}
                <span class="row-main">
                  <span class="t-title row-title">
                    {item.title}
                    {item.external && <Fragment set:html={arrow} />}
                  </span>
                  <span class="row-desc">{item.description}</span>
                </span>
                <span class="t-meta row-meta">
                  {item.kind}<span class="row-sep" aria-hidden="true">·</span>{item.now ? "now" : item.year}
                </span>
              </a>
            </li>
          ))}
        </ol>
      </section>

      <section class="about animate-in" style="animation-delay: 0.46s">
        <p class="t-body about-copy">
          Artoshi Rei designs and builds calm, considered digital products —
          mostly small, sharp macOS apps and the sites around them.
        </p>
        <nav class="socials" aria-label="Social links">
          {socials.map((s) => (
            <a class="quiet-link social-link" href={s.href} target="_blank" rel="noopener noreferrer">{s.label}</a>
          ))}
        </nav>
      </section>
    </main>

    <footer class="foot animate-in-fade" style="animation-delay: 0.54s">
      <span class="t-meta">© 2026 artoshi</span>
      <span class="t-meta">made on earth</span>
    </footer>
  </div>
</BaseLayout>

<style>
  .page {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    padding: clamp(1.5rem, 4vw, 3.5rem) var(--gutter) clamp(1.5rem, 3vw, 2.5rem);
  }
  .col, .top, .foot {
    width: 100%;
    max-width: var(--column);
    margin-inline: auto;
  }

  /* ─── header ──────────────────────────────────────────── */
  .top {
    padding-bottom: clamp(1.1rem, 2.5vh, 1.6rem);
    border-bottom: var(--hair) solid var(--line);
  }
  .brand {
    position: relative; /* anchors the mascot speech bubble */
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    color: var(--ink);
  }
  .brand-mascot { display: block; width: clamp(30px, 3vw, 40px); height: auto; overflow: visible; flex-shrink: 0; }
  .brand-word {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.35rem, 1.8vw, 1.7rem);
    letter-spacing: -0.02em;
    line-height: 1;
  }

  /* ─── hero ────────────────────────────────────────────── */
  .hero { padding: clamp(4rem, 11vh, 8rem) 0 clamp(3rem, 8vh, 5.5rem); }
  .t-hero { margin: 0; }
  .hero-line { display: block; }
  .hero-sub {
    margin: 1.5rem 0 0;
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--ink-mute);
    max-width: 44ch;
  }

  .quiet-link {
    color: var(--ink);
    text-decoration: none;
    box-shadow: inset 0 -1px 0 var(--accent-quiet);
    transition: color 0.18s ease, box-shadow 0.18s ease;
  }
  .quiet-link:hover { color: var(--accent); box-shadow: inset 0 -1px 0 var(--accent); }

  /* ─── the index ───────────────────────────────────────── */
  .work { padding-bottom: clamp(3rem, 8vh, 5.5rem); }
  .work-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }
  .row {
    position: relative;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.5rem;
    margin-inline: calc(-1 * clamp(1.1rem, 2vw, 1.6rem));
    padding: clamp(1rem, 1.8vw, 1.35rem) clamp(1.1rem, 2vw, 1.6rem);
    border-radius: var(--radius);
    text-decoration: none;
    color: var(--ink);
    transition: background-color 0.22s var(--ease-out);
  }
  @media (pointer: fine) {
    .row:hover:not(:has(.now-dot:hover)) { background: var(--paper-sunk); }
    .row:hover:not(:has(.now-dot:hover)) .row-title { color: var(--accent); }
  }
  .row-main {
    display: flex;
    align-items: baseline;
    gap: 0.4rem 1.1rem;
    flex-wrap: wrap;
    min-width: 0;
  }
  .row-title {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    transition: color 0.22s var(--ease-out);
  }
  .row-title :global(.row-arrow) { color: var(--ink-faint); transition: color 0.22s var(--ease-out), transform 0.22s var(--ease-out); }
  .row:hover:not(:has(.now-dot:hover)) .row-title :global(.row-arrow) {
    color: var(--accent);
    transform: translate(1px, -1px);
  }
  .row-desc {
    font-size: var(--fs-body);
    color: var(--ink-mute);
    line-height: 1.4;
  }
  .row-meta { flex-shrink: 0; color: var(--ink-faint); white-space: nowrap; transition: color 0.22s var(--ease-out); }
  @media (pointer: fine) {
    .row:hover:not(:has(.now-dot:hover)) .row-meta { color: var(--ink-mute); }
  }
  .row-sep { margin: 0 0.45em; }

  .now-dot {
    --dot: 0.5rem;
    /* centered in the row's left padding gutter, on the title's vertical middle */
    position: absolute;
    left: -0.6rem; /* fully outside the hover surface, in the left margin */
    top: calc(clamp(1rem, 1.8vw, 1.35rem) + (var(--fs-title) * 1.1 / 2));
    transform: translate(-50%, -50%);
    width: var(--dot);
    height: var(--dot);
    border-radius: 999px;
    color: var(--accent);
    background: currentColor;
    line-height: 0;
  }
  .now-dot::before {
    /* larger invisible hit area for the tooltip */
    content: "";
    position: absolute;
    inset: -0.5rem;
  }
  .now-dot::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: currentColor;
    animation: pulse-dot 1.6s var(--ease-out) infinite;
  }
  .now-tip {
    position: absolute;
    bottom: calc(100% + 0.7rem);
    left: -0.4rem;
    padding: 0.4rem 0.65rem;
    border-radius: 8px;
    background: var(--paper-sunk);
    border: var(--hair) solid var(--line-strong);
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: var(--fs-meta);
    letter-spacing: var(--tr-meta);
    line-height: 1;
    white-space: nowrap;
    opacity: 0;
    transform: translateY(3px);
    pointer-events: none;
    transition: opacity 0.18s var(--ease-out), transform 0.18s var(--ease-out);
  }
  .now-dot:hover .now-tip {
    opacity: 1;
    transform: translateY(0);
  }
  @keyframes pulse-dot {
    0% { opacity: 0.55; transform: scale(1); }
    70%, 100% { opacity: 0; transform: scale(2.35); }
  }
  @media (prefers-reduced-motion: reduce) {
    .now-dot::after { animation: none; }
  }

  /* ─── about + socials ─────────────────────────────────── */
  .about {
    padding: clamp(2.5rem, 6vh, 4rem) 0 clamp(3.5rem, 9vh, 6rem);
    border-top: var(--hair) solid var(--line);
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }
  .about-copy { margin: 0; color: var(--ink-mute); }
  .socials { display: flex; gap: 1.6rem; }
  .social-link {
    font-family: var(--font-mono);
    font-size: var(--fs-meta);
    letter-spacing: var(--tr-meta);
  }

  /* ─── footer ──────────────────────────────────────────── */
  .foot {
    margin-top: auto;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-top: clamp(1.1rem, 2.5vh, 1.6rem);
    border-top: var(--hair) solid var(--line);
  }
  .foot .t-meta { color: var(--ink-faint); }

  /* ─── small screens ───────────────────────────────────── */
  @media (max-width: 560px) {
    .row { flex-direction: column; align-items: flex-start; gap: 0.3rem; }
    .row-main { flex-direction: column; align-items: flex-start; gap: 0.25rem; }
    /* no room in the viewport gutter (and no hover surface on touch) — keep the dot inside */
    .now-dot { left: calc(clamp(1.1rem, 2vw, 1.6rem) / 2 - 0.1rem); }
  }
</style>

<script>
  import { init, watchRows } from "../scripts/mascotEye";
  import { initSpeech } from "../scripts/mascotSpeech";
  init(document.getElementById("mascot-icon") as unknown as SVGSVGElement | null);
  watchRows(document.querySelectorAll(".work-list .row"));
  initSpeech(document.querySelector(".brand"));
</script>
