---
// src/pages/index.astro — ARTOSHI · quiet single-column index
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { work } from "../data/work";

const arrow = `<svg class="row-arrow" viewBox="0 0 32 32" width="11" height="11" fill="currentColor" aria-hidden="true"><path d="M10 6L10 8 22.59 8 6 24.59 7.41 26 24 9.41 24 22 26 22 26 6 10 6z"/></svg>`;
const workSections = [
  { kind: "app", label: "apps" },
  { kind: "website", label: "websites" },
  { kind: "experiment", label: "experiments" },
] as const;

const socials = [
  { label: "x", href: "https://x.com/artoshiverse" },
  { label: "github", href: "https://github.com/artoshirei" },
];
---

<BaseLayout title="artoshi — design + development">
  <div class="page">
    <SiteHeader class="animate-in-fade" />

    <main class="col">
      <section class="hero">
        <h1 class="t-hero">
          <span class="hero-line animate-in" style="animation-delay: 0.08s">I design &amp; build</span>
          <span class="hero-line animate-in" style="animation-delay: 0.16s">digital products.</span>
        </h1>
        <p class="hero-sub animate-in" style="animation-delay: 0.26s">
          Building a small suite of calm apps for the Mac.<br />
          BA Graphic Communication Design, <a href="https://www.arts.ac.uk/colleges/central-saint-martins" target="_blank" rel="noopener noreferrer" class="quiet-link">Central Saint Martins</a>.
        </p>
      </section>

      <section class="work animate-in" style="animation-delay: 0.36s" aria-label="Selected work">
        {workSections.map((section) => {
          const items = work.filter((item) => item.kind === section.kind);
          return items.length > 0 && (
            <section class="work-section" aria-labelledby={`work-${section.kind}`}>
              <h2 id={`work-${section.kind}`} class="t-meta work-heading">{section.label}</h2>
              <ol class="work-list">
                {items.map((item) => {
                  const rowContent = (
                    <>
                      {item.now && (
                        <span class="now-dot" aria-label="Building right now">
                          <span class="now-tip" role="tooltip">building right now</span>
                        </span>
                      )}
                      {item.kind === "app" && (
                        item.icon ? (
                          <img class="app-face" src={item.icon} alt="" width="56" height="56" loading="lazy" />
                        ) : (
                          <span class="app-face app-face-soon" aria-hidden="true">
                            <svg class="soon-mascot" viewBox="0 0 649 512" xmlns="http://www.w3.org/2000/svg">
                              <path class="soon-body" d="M562.831 269.466C613.091 251.273 649 203.129 649 146.602C649 74.4521 590.502 15.9636 518.341 15.9636C481.989 15.9636 449.102 30.8084 425.419 54.7668C403.962 21.7985 366.776 0 324.502 0C282.224 0 245.042 21.7985 223.58 54.7668C199.898 30.8084 167.011 15.9636 130.659 15.9636C58.4976 15.9636 0 74.4521 0 146.602C0 204.876 38.1635 254.242 90.8688 271.071C54.4352 294.25 30.2622 334.981 30.2622 381.361C30.2622 453.511 88.7598 512 160.921 512C192.767 512 221.954 500.61 244.625 481.673C265.871 500.537 293.844 512 324.502 512C356.882 512 386.271 499.212 407.9 478.416C431.057 499.294 461.724 512 495.36 512C567.521 512 626.019 453.511 626.019 381.361C626.019 333.897 600.701 292.344 562.831 269.466Z" />
                              <g class="soon-eyes">
                                <rect x="250.92" y="156.08" width="46" height="198" rx="23" />
                                <rect x="339.42" y="156.08" width="46" height="198" rx="23" />
                              </g>
                            </svg>
                          </span>
                        )
                      )}
                      <span class="row-main">
                        <span class="t-title row-title">
                          {item.title}
                          {item.external && <Fragment set:html={arrow} />}
                        </span>
                        <span class="row-desc">{item.description}</span>
                      </span>
                      <span class="t-meta row-meta">
                        {item.now ? "now" : item.year}
                      </span>
                    </>
                  );

                  return (
                    <li>
                      {item.url ? (
                        <a
                          class:list={["row", item.kind === "app" && "row-app"]}
                          href={item.url}
                          {...(item.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
                        >
                          {rowContent}
                        </a>
                      ) : (
                        <div class:list={["row", "row-static", item.kind === "app" && "row-app"]}>
                          {rowContent}
                        </div>
                      )}
                    </li>
                  );
                })}
              </ol>
            </section>
          );
        })}
      </section>

      <section class="about animate-in" style="animation-delay: 0.46s">
        <p class="t-body about-copy">
          Artoshi Rei designs and builds calm, considered digital products —
          mostly small, sharp macOS apps and the sites around them.
        </p>
        <nav class="socials" aria-label="Social links">
          {socials.map((s) => (
            <a class="quiet-link social-link" href={s.href} target="_blank" rel="noopener noreferrer">{s.label}</a>
          ))}
        </nav>
      </section>
    </main>

    <footer class="foot animate-in-fade" style="animation-delay: 0.54s">
      <span class="t-meta">© 2026 artoshi</span>
      <span class="t-meta">made on earth</span>
    </footer>
  </div>
</BaseLayout>

<style>
  .page {
    /* Hover timing is asymmetric, and every hover-driven property on the page
       reads these two inherited vars so a whole row turns as one thing.
       Coming IN is quick and front-loaded; going OUT is slower and starts
       gently, because the expo arrival curve played backwards dumps ~half its
       distance in the first few frames and reads as a snap-back. Each
       hoverable re-declares the pair inside its own :hover. Plain CSS
       transitions, so interrupting a leave reverses from wherever it got to. */
    --hov-dur: 0.34s;
    --hov-ease: var(--ease-settle);

    min-height: 100svh;
    display: flex;
    flex-direction: column;
    padding: clamp(1.5rem, 4vw, 3.5rem) var(--gutter) clamp(1.5rem, 3vw, 2.5rem);
  }
  .col, .foot {
    width: 100%;
    max-width: var(--column);
    margin-inline: auto;
  }

  /* ─── hero ────────────────────────────────────────────── */
  .hero { padding: clamp(4rem, 11vh, 8rem) 0 clamp(3rem, 8vh, 5.5rem); }
  .t-hero { margin: 0; }
  .hero-line { display: block; }
  .hero-sub {
    margin: 1.5rem 0 0;
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--ink-mute);
    max-width: 44ch;
  }

  .quiet-link {
    color: var(--ink);
    text-decoration: none;
    box-shadow: inset 0 -1px 0 var(--accent-quiet);
    transition: color var(--hov-dur) var(--hov-ease), box-shadow var(--hov-dur) var(--hov-ease);
  }
  .quiet-link:hover {
    --hov-dur: 0.18s;
    --hov-ease: var(--ease-out);
    color: var(--accent);
    box-shadow: inset 0 -1px 0 var(--accent);
  }

  /* ─── the index ───────────────────────────────────────── */
  .work { padding-bottom: clamp(3rem, 8vh, 5.5rem); }
  .work {
    display: flex;
    flex-direction: column;
    gap: clamp(2rem, 4.5vh, 3.2rem);
  }
  .work-section {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }
  .work-heading {
    margin: 0;
    color: var(--ink-faint);
  }
  .work-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }
  .row {
    position: relative;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.5rem;
    margin-inline: calc(-1 * clamp(1.1rem, 2vw, 1.6rem));
    padding: clamp(1rem, 1.8vw, 1.35rem) clamp(1.1rem, 2vw, 1.6rem);
    border-radius: var(--radius);
    text-decoration: none;
    color: var(--ink);
    transition: background-color var(--hov-dur) var(--hov-ease);
  }
  .row-static { cursor: default; }
  @media (pointer: fine) {
    a.row:hover:not(:has(.now-dot:hover)) {
      --hov-dur: 0.2s;
      --hov-ease: var(--ease-out);
      background: var(--paper-sunk);
    }
    a.row:hover:not(:has(.now-dot:hover)) .row-title { color: var(--accent); }
  }
  .row-main {
    display: flex;
    align-items: baseline;
    gap: 0.4rem 1.1rem;
    flex-wrap: wrap;
    min-width: 0;
  }
  .row-title {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    transition: color var(--hov-dur) var(--hov-ease);
  }
  .row-title :global(.row-arrow) {
    color: var(--ink-faint);
    transition: color var(--hov-dur) var(--hov-ease), transform var(--hov-dur) var(--hov-ease);
  }
  a.row:hover:not(:has(.now-dot:hover)) .row-title :global(.row-arrow) {
    color: var(--accent);
    transform: translate(1px, -1px);
  }
  .row-desc {
    font-size: var(--fs-body);
    color: var(--ink-mute);
    line-height: 1.4;
  }

  /* ─── the app shelf ───────────────────────────────────── */
  /* App rows carry a real macOS icon face; the row goes two-line
     (title over description) so the text block fills the icon's height. */
  .row-app {
    align-items: center;
    gap: clamp(0.9rem, 1.8vw, 1.2rem);
  }
  .row-app .row-main {
    flex-direction: column;
    align-items: flex-start;
    gap: 0.2rem;
    flex: 1;
    min-width: 0;
  }
  .app-face {
    flex: 0 0 56px;
    width: 56px;
    height: 56px;
    display: block;
  }
  a.row-app .app-face {
    /* the lift is the one that gave the drop away most: 2px of expo unwinding
       is a single-frame flick. It gets a touch more time than the colours. */
    transition: transform calc(var(--hov-dur) + 0.06s) var(--hov-ease);
  }
  @media (pointer: fine) {
    a.row-app:hover:not(:has(.now-dot:hover)) .app-face { transform: translateY(-2px); }
  }

  /* coming-soon tile: an unhatched app. Same footprint as a real macOS
     icon (46px squircle inside the 56px cell, matching the icon-grid
     margins baked into the PNGs), with the mascot's silhouette waiting
     inside — it blinks now and then — and a slow shimmer sweeping past. */
  .app-face-soon {
    flex-basis: 46px;
    width: 46px;
    height: 46px;
    margin: 5px;
    position: relative;
    overflow: hidden;
    border-radius: 10.5px; /* ~22.4% — the macOS squircle ratio */
    background: var(--paper-sunk);
    border: var(--hair) solid var(--line);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .soon-mascot {
    width: 60%;
    height: auto;
    overflow: visible;
  }
  .soon-body { fill: color-mix(in srgb, var(--ink-faint) 42%, transparent); }
  .soon-eyes rect {
    fill: var(--paper-sunk); /* cut-out eyes in the silhouette */
    transform-box: fill-box;
    transform-origin: center;
    animation: soon-blink 5.6s linear infinite;
  }
  /* the unhatched ones shouldn't blink in sync */
  .work-list li:nth-child(even) .soon-eyes rect { animation-delay: 1.9s; }
  .work-list li:nth-child(5n) .soon-eyes rect { animation-delay: 3.4s; }
  @keyframes soon-blink {
    0%, 91%, 96%, 100% { transform: scaleY(1); }
    93.5% { transform: scaleY(0.08); }
  }
  .app-face-soon::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      115deg,
      transparent 32%,
      rgba(236, 231, 222, 0.05) 46%,
      rgba(236, 231, 222, 0.1) 52%,
      transparent 68%
    );
    transform: translateX(-100%);
    animation: soon-shimmer 4.2s ease-in-out infinite;
  }
  @keyframes soon-shimmer {
    0% { transform: translateX(-100%); }
    46%, 100% { transform: translateX(100%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .soon-eyes rect, .app-face-soon::after { animation: none; }
  }
  .row-meta { flex-shrink: 0; color: var(--ink-faint); white-space: nowrap; transition: color var(--hov-dur) var(--hov-ease); }
  @media (pointer: fine) {
    a.row:hover:not(:has(.now-dot:hover)) .row-meta { color: var(--ink-mute); }
  }

  .now-dot {
    --dot: 0.5rem;
    /* sits in the row's left padding gutter, fully left of the app icon,
       vertically centered — absolute, so it never nudges the row content
       and all rows stay aligned. The padding (min 1.1rem) always fits
       inside --gutter (min 1.25rem), so it can't fall offscreen, and the
       same rule holds at every viewport width — no breakpoint snapping. */
    position: absolute;
    left: calc((clamp(1.1rem, 2vw, 1.6rem) - var(--dot)) / 2);
    top: 50%;
    translate: 0 -50%;
    width: var(--dot);
    height: var(--dot);
    border-radius: 999px;
    color: #9dc383; /* calm green — "alive right now", distinct from the accent orange */
    background: currentColor;
    line-height: 0;
    /* own stacking context: the tooltip must paint over the app icons,
       whose hover-lift transform would otherwise stack above it */
    z-index: 6;
  }
  .now-dot::before {
    /* larger invisible hit area for the tooltip */
    content: "";
    position: absolute;
    inset: -0.5rem;
  }
  .now-dot::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: currentColor;
    animation: pulse-dot 1.6s var(--ease-out) infinite;
  }
  .now-tip {
    position: absolute;
    bottom: calc(100% + 0.7rem);
    left: 0; /* dot hugs the viewport edge on small screens — grow rightward only */
    padding: 0.4rem 0.65rem;
    border-radius: 8px;
    background: var(--paper-sunk);
    border: var(--hair) solid var(--line-strong);
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: var(--fs-meta);
    letter-spacing: var(--tr-meta);
    line-height: 1;
    white-space: nowrap;
    opacity: 0;
    transform: translateY(3px);
    pointer-events: none;
    /* tighter than the rows either way — a tooltip that lingers reads as stuck */
    transition: opacity 0.24s var(--ease-settle), transform 0.24s var(--ease-settle);
  }
  .now-dot:hover .now-tip {
    opacity: 1;
    transform: translateY(0);
    transition-duration: 0.16s;
    transition-timing-function: var(--ease-out);
  }
  @keyframes pulse-dot {
    0% { opacity: 0.55; transform: scale(1); }
    70%, 100% { opacity: 0; transform: scale(2.35); }
  }
  @media (prefers-reduced-motion: reduce) {
    .now-dot::after { animation: none; }
  }

  /* ─── about + socials ─────────────────────────────────── */
  .about {
    padding: clamp(2.5rem, 6vh, 4rem) 0 clamp(3.5rem, 9vh, 6rem);
    border-top: var(--hair) solid var(--line);
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }
  .about-copy { margin: 0; color: var(--ink-mute); }
  .socials { display: flex; gap: 1.6rem; }
  .social-link {
    font-family: var(--font-mono);
    font-size: var(--fs-meta);
    letter-spacing: var(--tr-meta);
  }

  /* ─── footer ──────────────────────────────────────────── */
  .foot {
    margin-top: auto;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-top: clamp(1.1rem, 2.5vh, 1.6rem);
    border-top: var(--hair) solid var(--line);
  }
  .foot .t-meta { color: var(--ink-faint); }

  /* ─── small screens ───────────────────────────────────── */
  @media (max-width: 560px) {
    .row { flex-direction: column; align-items: flex-start; gap: 0.3rem; }
    .row-main { flex-direction: column; align-items: flex-start; gap: 0.25rem; }
    /* app rows keep the icon beside the text — a face above a caption
       reads as a broken card, not a shelf */
    .row-app { flex-direction: row; align-items: center; gap: 0.85rem; }
    .row-app .row-meta { display: none; } /* the dot already says "now"; year yields to space */
  }
</style>

<script>
  import { watchRows } from "../scripts/mascotEye";
  // mascot init + speech live in MascotBrand; the index only opts its work
  // rows into the happy-hop hover. Rows are fresh DOM on every client-side
  // navigation, so this re-runs per visit (astro:page-load also fires on
  // the initial load).
  document.addEventListener("astro:page-load", () => {
    watchRows(document.querySelectorAll(".work-list .row"));
  });
</script>
