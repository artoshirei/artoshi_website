---
// src/layouts/BaseLayout.astro
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  image?: string;
  imageVersion?: string;
  imageAlt?: string;
  type?: string;
  twitterSite?: string;
  twitterCreator?: string;
}

const {
  title = "artoshi — design + development",
  description = "Designer and developer portfolio",
  canonicalPath = Astro.url.pathname,
  image = "/logo.svg",
  imageVersion,
  imageAlt = "artoshi logo",
  type = "website",
  twitterSite = "@artoshiverse",
  twitterCreator,
} = Astro.props;

const site = "https://artoshi.work";
const canonicalUrl = new URL(canonicalPath, site).toString();
const imageUrlObject = new URL(image, site);
if (imageVersion) {
  imageUrlObject.searchParams.set("v", imageVersion);
}
const imageUrl = imageUrlObject.toString();
const imagePath = imageUrlObject.pathname;
const imageType = imagePath.endsWith(".png")
  ? "image/png"
  : imagePath.endsWith(".jpg") || imagePath.endsWith(".jpeg")
    ? "image/jpeg"
    : imagePath.endsWith(".webp")
      ? "image/webp"
      : "image/svg+xml";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="artoshi.work" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:secure_url" content={imageUrl} />
    <meta property="og:image:type" content={imageType} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={twitterSite} />
    {twitterCreator && <meta name="twitter:creator" content={twitterCreator} />}
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <meta name="theme-color" content="#131110" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@10..96,600;10..96,700&family=Hanken+Grotesk:wght@400;600&family=Spline+Sans+Mono:wght@400&display=swap" />
    <ClientRouter />
    <script>
      // Entrance animations (.animate-in / .animate-in-fade) are a first-load
      // hello, not a per-navigation stutter: once the visitor starts moving
      // between pages, `nav-visited` turns them off so swapped-in pages (and
      // the persisted mascot's header) appear settled.
      // `page-enter` drives the per-swap content fade-in (see global.css) —
      // removed and re-added each swap so the animation restarts. The reflow
      // read between the two is what makes the browser treat it as new.
      document.addEventListener("astro:after-swap", () => {
        const root = document.documentElement;
        root.classList.add("nav-visited");
        root.classList.remove("page-enter");
        void root.offsetWidth;
        root.classList.add("page-enter");
      });
    </script>
  </head>
  <body class="min-h-screen flex flex-col">
    <slot />
  </body>
</html>
