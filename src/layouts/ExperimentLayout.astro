---
// src/layouts/ExperimentLayout.astro
import GridFrame from "./GridFrame.astro";

interface Props {
  title?: string;
  breadcrumb?: string;
}
const { title = "ARTOSHI — design + development", breadcrumb = "LAB" } = Astro.props;
---

<GridFrame title={title} breadcrumb={breadcrumb}>
  <div class="experiment-main">
    <slot />
  </div>
</GridFrame>

<style>
  .experiment-main {
    flex: 1 1 auto;
    min-height: 0;
    display: flex;
    flex-direction: column;
  }
</style>
