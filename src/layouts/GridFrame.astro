---
// src/layouts/GridFrame.astro
// Shared inner-page shell in the QUIET INDEX language: warm canvas, a small
// top bar with the mascot mark + artoshi home link and a quiet breadcrumb,
// and a minimal footer. Inner pages slot their content/demos.
import BaseLayout from "./BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  image?: string;
  imageVersion?: string;
  imageAlt?: string;
  breadcrumb?: string;
}
const {
  title = "artoshi — design + development",
  description,
  canonicalPath,
  image,
  imageVersion,
  imageAlt,
  breadcrumb,
} = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  image={image}
  imageVersion={imageVersion}
  imageAlt={imageAlt}
>
  <div class="shell">
    <SiteHeader breadcrumb={breadcrumb} />

    <main class="shell-body">
      <slot />
    </main>

    <footer class="shell-foot">
      <a href="/" class="shell-back">← index</a>
      <span class="t-meta shell-copy">© 2026 artoshi</span>
    </footer>
  </div>
</BaseLayout>

<style>
  .shell {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    padding: clamp(1.5rem, 4vw, 3.5rem) var(--gutter) clamp(1.5rem, 3vw, 2.5rem);
  }

  .shell-foot {
    width: 100%;
    max-width: var(--column);
    margin-inline: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .shell-body {
    position: relative;
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  .shell-foot {
    margin-top: clamp(1.5rem, 4vh, 2.5rem);
    padding-top: clamp(1.1rem, 2.5vh, 1.6rem);
    border-top: var(--hair) solid var(--line);
  }
  .shell-back {
    font-family: var(--font-mono);
    font-size: var(--fs-meta);
    letter-spacing: var(--tr-meta);
    color: var(--ink-mute);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .shell-back:hover { color: var(--accent); }
  .shell-copy { color: var(--ink-faint); }
</style>

